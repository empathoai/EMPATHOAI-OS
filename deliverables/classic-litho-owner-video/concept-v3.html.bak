<!doctype html>
<html lang="en" data-resolution="landscape"><head>
<meta charset="utf-8"><meta name="viewport" content="width=1920,height=1080">
<title>Classic Litho — Print Language Proof</title><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<style>
@font-face{font-family:Plex;src:url('public/assets/fonts/ibm-plex-sans-700.ttf')}@font-face{font-family:Mono;src:url('public/assets/fonts/ibm-plex-mono-400.ttf')}*{box-sizing:border-box}html,body{margin:0;width:1920px;height:1080px;overflow:hidden;background:#080808}#root{position:relative;width:1920px;height:1080px;overflow:hidden;background:#080808;color:#f8f5ec;font-family:Plex,Arial,sans-serif}.clip{position:absolute;inset:0;overflow:hidden}.ink{position:absolute;inset:-10%;background-image:radial-gradient(circle,#f8f5ec 1px,transparent 1.3px);background-size:8px 8px;opacity:.09}.reg{position:absolute;width:54px;height:54px;border:1px solid rgba(248,245,236,.7);border-radius:50%}.reg:before,.reg:after{content:'';position:absolute;background:#f8f5ec}.reg:before{width:76px;height:1px;top:26px;left:-12px}.reg:after{height:76px;width:1px;left:26px;top:-12px}.small{font:18px Mono,monospace;letter-spacing:.14em;text-transform:uppercase}.word{position:absolute;font-size:232px;line-height:.74;letter-spacing:-.08em;white-space:nowrap}.white{color:#f8f5ec}.orange{color:#ff4402}.cmyk{position:absolute;width:680px;height:680px;border-radius:50%;mix-blend-mode:screen;filter:blur(.2px)}.c{background:#00b7ee}.m{background:#e61e7a}.y{background:#ffdf00}.k{background:#1b1b1b;border:1px solid rgba(248,245,236,.35);mix-blend-mode:normal}.frame{position:absolute;border:2px solid #f8f5ec}.cutline{position:absolute;border:1px dashed rgba(248,245,236,.65)}.crop{position:absolute;overflow:hidden}.slab{position:absolute;background:#f8f5ec;color:#080808;padding:15px 22px;font:20px Mono,monospace;letter-spacing:.09em;text-transform:uppercase}.stamp{position:absolute;border:3px solid #ff4402;color:#ff4402;padding:11px 18px;font:26px Mono,monospace;letter-spacing:.08em;text-transform:uppercase}.measure{position:absolute;height:1px;background:#f8f5ec;transform-origin:left center}.measure:before{content:'';position:absolute;width:9px;height:9px;border-radius:50%;background:#ff4402;top:-4px}.logo{position:absolute;width:360px;height:auto}.ghost{position:absolute;color:rgba(248,245,236,.08);font-size:480px;line-height:.7;letter-spacing:-.1em}.lock{position:absolute;width:38px;height:38px;border:3px solid #ff4402}.lock:after{content:'';position:absolute;width:16px;height:16px;left:8px;top:8px;background:#ff4402}.fine{position:absolute;font:16px Mono,monospace;letter-spacing:.12em;color:#aaa69e;text-transform:uppercase}
</style></head><body><div id="root" data-composition-id="classic-litho-print-language-proof" data-start="0" data-duration="21.552" data-width="1920" data-height="1080">
<audio id="narration" src="public/narration.mp3" data-start="0" data-duration="21.552" data-volume="1"></audio>
<img id="emBrand" src="public/assets/empathoai-logo.svg" alt="EmpathoAI" style="position:absolute;right:108px;top:88px;width:235px;height:auto;z-index:10">
<div id="emThesis" class="fine" style="right:110px;bottom:70px;z-index:10;text-align:right">Human depth. Machine leverage.<br>Precision over volume.</div>
<section id="p1" class="clip" data-start="0" data-duration="11.46" data-track-index="1"><div class="ink"></div><div id="p1reg" class="reg" style="left:110px;top:110px"></div><div id="p1meta" class="small" style="position:absolute;left:190px;top:130px">Classic Litho + Design / Publicly demonstrated</div><img id="p1logo" class="logo" src="public/assets/classic-litho-logo-official.png" alt="Classic Litho + Design" style="left:780px;top:360px">
<div id="cyan" class="cmyk c" style="left:760px;top:200px"></div><div id="magenta" class="cmyk m" style="left:880px;top:260px"></div><div id="yellow" class="cmyk y" style="left:820px;top:390px"></div><div id="black" class="cmyk k" style="left:920px;top:320px"></div>
<div id="p1headline" class="word white" style="left:110px;top:510px;font-size:174px">HIGH-IMPACT WORK<br><span class="orange">MADE PHYSICAL.</span></div><div id="p1bottom" class="fine" style="left:110px;bottom:105px">Four physical expressions / one execution discipline</div></section>
<section id="p2" class="clip" data-start="2.3" data-duration="9.16" data-track-index="2"><div id="packBoard" class="frame" style="left:115px;top:150px;width:680px;height:690px"></div><div id="packCut" class="cutline" style="left:164px;top:204px;width:580px;height:580px"></div><div id="packWord" class="word white" style="left:160px;top:430px;font-size:198px">PACK<br>AGING</div><div id="packLabel" class="slab" style="left:115px;top:870px">01 / Packaging</div><div id="packFold1" class="measure" style="left:880px;top:300px;width:650px;transform:rotate(-18deg)"></div><div id="packFold2" class="measure" style="left:880px;top:580px;width:650px;transform:rotate(18deg)"></div><div id="packNote" class="fine" style="right:155px;top:405px;width:470px">Die line / fold / finish<br>Physical idea becomes a controlled object</div></section>
<section id="p3" class="clip" data-start="4.5" data-duration="6.96" data-track-index="3"><div id="retailBand" style="position:absolute;left:-50px;top:380px;width:2020px;height:315px;background:#ff4402"></div><div id="retailWord" class="word" style="left:105px;top:370px;font-size:285px;color:#080808">RETAIL</div><div id="retailK" class="word white" style="right:112px;top:205px;font-size:105px">RETAIL<br>SURFACES<br>THAT SELL.</div><div id="retailReg1" class="reg" style="right:440px;bottom:126px;border-color:#ff4402"></div><div id="retailReg2" class="reg" style="right:330px;bottom:126px;border-color:#ff4402"></div><div id="retailReg3" class="reg" style="right:220px;bottom:126px;border-color:#ff4402"></div></section>
<section id="p4" class="clip" data-start="6.7" data-duration="4.76" data-track-index="4"><div id="largeType" class="ghost" style="left:-28px;top:205px">LARGE</div><div id="largeCrop" class="crop" style="left:105px;top:140px;width:1710px;height:760px;border-top:2px solid #f8f5ec;border-bottom:2px solid #f8f5ec"><div id="largeWord" class="word white" style="left:0;top:220px;font-size:300px">FORMAT</div></div><div id="largeStamp" class="stamp" style="right:112px;bottom:106px">Scale carries the message.</div></section>
<section id="p5" class="clip" data-start="8.85" data-duration="2.61" data-track-index="5"><div id="physRing" style="position:absolute;left:580px;top:140px;width:760px;height:760px;border:86px solid #ff4402;border-radius:50%"></div><div id="physText" class="word white" style="left:220px;top:438px;font-size:148px">BRANDED PHYSICAL<br>EXPERIENCES.</div><div id="physFine" class="fine" style="left:225px;top:260px">Where a brand occupies real space</div></section>
<section id="p6" class="clip" data-start="11.46" data-duration="10.092" data-track-index="1"><div class="ink"></div><div id="moreGhost" class="ghost" style="left:-25px;top:210px">MORE</div><div id="moreWord" class="word white" style="left:108px;top:340px;font-size:190px">THIS IS MORE THAN<br><span class="orange">PRODUCTION CAPABILITY.</span></div><div id="moreStamp" class="stamp" style="left:115px;bottom:132px">Proof of execution</div><div id="moreRule" class="measure" style="left:110px;top:815px;width:1320px"></div><div id="moreFine" class="fine" style="right:120px;bottom:145px;width:360px">A public body of work signals the discipline required to deliver.</div></section>
<section id="p7" class="clip" data-start="15.105" data-duration="6.447" data-track-index="2"><div id="qWord" class="word white" style="left:105px;top:190px;font-size:272px">QUALITY</div><div id="cWord" class="word white" style="left:105px;top:455px;font-size:272px">CONSISTENCY</div><div id="eWord" class="word orange" style="left:105px;top:720px;font-size:272px">EXECUTION</div><div id="locks"><div class="lock" style="right:150px;top:250px"></div><div class="lock" style="right:150px;top:510px"></div><div class="lock" style="right:150px;top:770px"></div></div><div id="lockRule" class="measure" style="right:188px;top:268px;width:510px;transform:rotate(90deg)"></div><div id="matter" class="small" style="position:absolute;right:175px;top:82px;width:310px">When quality,<br>consistency and execution matter.</div></section>
</div><script>window.__timelines=window.__timelines||{};const tl=gsap.timeline({paused:true});const ft=(s,f,t,a)=>tl.fromTo(s,f,{...t,immediateRender:false},a);ft('#emBrand',{opacity:0,y:-18},{opacity:1,y:0,duration:.5,ease:'power2.out'},.12);ft('#emThesis',{opacity:0},{opacity:1,duration:.7,ease:'sine.out'},.5);ft('#p1reg',{opacity:0,rotation:-90},{opacity:1,rotation:0,duration:.55,ease:'expo.out'},.18);ft('#p1meta',{opacity:0,x:-60},{opacity:1,x:0,duration:.6,ease:'expo.out'},.32);ft('#p1headline',{opacity:0,x:-160,letterSpacing:'-.16em'},{opacity:1,x:0,letterSpacing:'-.08em',duration:.8,ease:'power4.out'},.55);ft('#cyan',{opacity:0,x:-220,y:100,scale:.2},{opacity:.82,x:0,y:0,scale:1,duration:.8,ease:'expo.out'},.65);ft('#magenta',{opacity:0,x:260,y:-140,scale:.2},{opacity:.78,x:0,y:0,scale:1,duration:.8,ease:'expo.out'},.78);ft('#yellow',{opacity:0,y:240,scale:.2},{opacity:.75,y:0,scale:1,duration:.8,ease:'expo.out'},.92);ft('#black',{opacity:0,scale:.25},{opacity:.5,scale:1,duration:.65,ease:'power3.out'},1.06);ft('#p1logo',{opacity:0,scale:.72},{opacity:1,scale:1,duration:.65,ease:'power3.out'},1.18);ft('#p1bottom',{opacity:0,y:20},{opacity:1,y:0,duration:.5,ease:'power2.out'},1.4);tl.to('#cyan',{x:45,y:-22,duration:8,ease:'none'},2).to('#magenta',{x:-52,y:20,duration:8,ease:'none'},2).to('#yellow',{x:22,y:-44,duration:8,ease:'none'},2);ft('#packBoard',{opacity:0,scale:.4,rotation:-14},{opacity:1,scale:1,rotation:0,duration:.7,ease:'expo.out'},2.45);ft('#packCut',{opacity:0,scale:.7},{opacity:1,scale:1,duration:.5,ease:'power2.out'},2.7);ft('#packWord',{opacity:0,y:100},{opacity:1,y:0,duration:.65,ease:'power4.out'},2.9);ft('#packFold1,#packFold2',{opacity:0,scaleX:0},{opacity:1,scaleX:1,duration:.5,stagger:.12,ease:'power2.out'},3.2);ft('#packLabel,#packNote',{opacity:0,y:30},{opacity:1,y:0,duration:.45,stagger:.12,ease:'power2.out'},3.6);ft('#retailBand',{scaleX:0},{scaleX:1,duration:.52,ease:'power4.out'},4.7);ft('#retailWord',{opacity:0,x:-240},{opacity:1,x:0,duration:.5,ease:'expo.out'},4.82);ft('#retailK',{opacity:0,x:100},{opacity:1,x:0,duration:.5,ease:'power3.out'},5.08);ft('#retailReg1,#retailReg2,#retailReg3',{opacity:0,scale:.2},{opacity:1,scale:1,duration:.3,stagger:.1,ease:'back.out(2)'},5.35);ft('#largeCrop',{opacity:0,scaleY:.05},{opacity:1,scaleY:1,duration:.52,ease:'power3.out'},6.9);ft('#largeType',{opacity:0,x:-180},{opacity:1,x:0,duration:.7,ease:'expo.out'},7.05);ft('#largeWord',{opacity:0,x:-180},{opacity:1,x:0,duration:.6,ease:'power4.out'},7.18);ft('#largeStamp',{opacity:0,rotation:-8,scale:.6},{opacity:1,rotation:0,scale:1,duration:.35,ease:'back.out(2)'},7.7);ft('#physRing',{opacity:0,scale:.1,rotation:-90},{opacity:1,scale:1,rotation:0,duration:.6,ease:'expo.out'},8.95);ft('#physText',{opacity:0,scale:1.2},{opacity:1,scale:1,duration:.55,ease:'power3.out'},9.2);ft('#physFine',{opacity:0,y:-30},{opacity:1,y:0,duration:.4,ease:'power2.out'},9.45);ft('#moreGhost',{opacity:0,x:-180},{opacity:1,x:0,duration:.75,ease:'expo.out'},11.66);ft('#moreWord',{opacity:0,y:130},{opacity:1,y:0,duration:.75,ease:'power4.out'},11.88);ft('#moreStamp',{opacity:0,scale:.6,rotation:-7},{opacity:1,scale:1,rotation:0,duration:.4,ease:'back.out(2)'},12.55);ft('#moreRule',{opacity:0,scaleX:0},{opacity:1,scaleX:1,duration:.7,ease:'power2.out'},12.8);ft('#moreFine',{opacity:0,x:50},{opacity:1,x:0,duration:.55,ease:'power3.out'},13.2);ft('#qWord',{opacity:0,x:-210},{opacity:1,x:0,duration:.5,ease:'expo.out'},15.3);ft('#cWord',{opacity:0,x:-210},{opacity:1,x:0,duration:.55,ease:'expo.out'},15.82);ft('#eWord',{opacity:0,x:-210},{opacity:1,x:0,duration:.6,ease:'expo.out'},16.4);ft('#locks .lock',{opacity:0,scale:.1},{opacity:1,scale:1,duration:.28,stagger:.17,ease:'back.out(2)'},16.15);ft('#lockRule',{opacity:0,scaleX:0},{opacity:1,scaleX:1,duration:.65,ease:'power2.out'},16.5);ft('#matter',{opacity:0,x:55},{opacity:1,x:0,duration:.5,ease:'power3.out'},17.1);
// Each phrase gets its own clean visual field: these are deliberate smash-cut exits,
// not accumulated slide layers.
tl.to('#p1 > *',{opacity:0,duration:.22,ease:'power4.in'},2.28)
  .to('#p2 > *',{opacity:0,duration:.18,ease:'power4.in'},4.48)
  .to('#p3 > *',{opacity:0,duration:.18,ease:'power4.in'},6.68)
  .to('#p4 > *',{opacity:0,duration:.18,ease:'power4.in'},8.82)
  .to('#p5 > *',{opacity:0,duration:.18,ease:'power4.in'},11.32)
  .to('#p6 > *',{opacity:0,duration:.22,ease:'power4.in'},15.00);
window.__timelines['classic-litho-print-language-proof']=tl;</script></body></html>